#!/usr/bin/env bash
#
# Termux AI Harness - a minimal human-in-the-loop shell agent backed by a
# local llama.cpp server. It turns natural language into shell commands,
# screens them for dangerous patterns, shows them to the operator and runs
# them only after explicit confirmation.
#
# The model answers in one of two shapes, and the harness routes them
# differently: TEXT: is printed and never executed, CMD: is offered for review.
#
# Requires: curl, jq
# License: MIT
#

set -uo pipefail

API_URL="${TERMUX_AI_URL:-http://127.0.0.1:8080/v1/chat/completions}"
MODEL="${TERMUX_AI_MODEL:-}"
TEMPERATURE="${TERMUX_AI_TEMPERATURE:-0.1}"
MAX_TOKENS="${TERMUX_AI_MAX_TOKENS:-256}"
TIMEOUT="${TERMUX_AI_TIMEOUT:-120}"
AUTO_RETRY="${TERMUX_AI_AUTO_RETRY:-0}"
MAX_RETRY="${TERMUX_AI_MAX_RETRY:-2}"

DEFAULT_PROMPT='You are Termux AI Harness, a shell command generator running on a local llama.cpp model.

Decide what the operator actually wants:
- If they ask a question, want an explanation, or are just chatting: reply with TEXT: followed by your answer. Never invent a command in this case.
- If they want something done on the machine: reply with CMD: followed by exactly one shell command. No alternatives, no explanation, no markdown, no comments.

Your reply must begin with CMD: or TEXT: and nothing else. Answer in the language the operator used, but keep the command itself plain ASCII.'

SYSTEM_PROMPT="${TERMUX_AI_HARNESS_SYSTEM:-$DEFAULT_PROMPT}"

# Dangerous pattern blacklist. Matched against the generated command.
DANGER_PATTERN='rm[[:space:]]+-[a-zA-Z]*[rf]|rm[[:space:]]+--(recursive|force)|mkfs|dd[[:space:]]+of=|shutdown|reboot|poweroff|halt|chmod[[:space:]]+-R[[:space:]]+777[[:space:]]+/|mv[[:space:]]+/\S+[[:space:]]+/\S+|:[[:space:]]*\(\)[[:space:]]*\{'

die() {
    printf 'error: %s\n' "$1" >&2
    exit 1
}

command -v curl >/dev/null 2>&1 || die "curl not found. Install it with: pkg install curl"
command -v jq >/dev/null 2>&1 || die "jq not found. Install it with: pkg install jq"

request_reply() {
    local prompt="$1"
    local extra='{}'
    [ -n "$MODEL" ] && extra=$(jq -n --arg m "$MODEL" '{model:$m}')

    local body
    body=$(jq -n \
        --argjson e "$extra" \
        --arg s "$SYSTEM_PROMPT" \
        --arg u "$prompt" \
        --argjson t "$TEMPERATURE" \
        --argjson m "$MAX_TOKENS" \
        '$e + {messages: [{role:"system",content:$s},{role:"user",content:$u}], temperature:$t, max_tokens:$m, stream:false}')

    local resp
    resp=$(curl -sS --max-time "$TIMEOUT" "$API_URL" \
        -H 'Content-Type: application/json' \
        -d "$body" 2>&1)

    if [ -z "$resp" ]; then
        printf 'error: empty response, is llama-server listening on %s ?\n' "$API_URL" >&2
        return 1
    fi

    local err
    err=$(jq -r 'if type=="object" then (.error // empty | if type=="object" then .message else . end) else empty end' <<<"$resp" 2>/dev/null)
    if [ -n "${err:-}" ]; then
        printf 'error: server says: %s\n' "$err" >&2
        return 1
    fi

    local raw
    raw=$(jq -r '.choices[0].message.content // .choices[0].text // empty' <<<"$resp" 2>/dev/null)
    [ -n "$raw" ] || { printf 'error: no content in response\n' >&2; return 1; }

    printf '%s\n' "$raw"
}

# Does this one-liner plausibly run in a shell?
looks_like_command() {
    local c="$1" first
    c=$(printf '%s' "$c" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    [ -n "$c" ] || return 1

    case "$c" in
        *'|'*|*'>'*|*'<'*|*'&&'*|*'$('*|*'`'*) return 0 ;;
    esac

    first=${c%% *}
    case "$first" in
        *[![:print:]]*) return 1 ;;
    esac
    command -v "$first" >/dev/null 2>&1
}

# Splits a model reply into REPLY_TYPE (text|cmd) and REPLY_BODY.
# Understands CMD: / TEXT: plus the CJK bracket forms 【CMD】【TEXT】.
parse_reply() {
    local raw first_line stripped

    raw=$(printf '%s\n' "$1" | sed -E -e 's/^[[:space:]]*```[a-zA-Z0-9_+-]*[[:space:]]*$//' -e 's/^[[:space:]]*```[[:space:]]*$//')
    first_line=$(printf '%s\n' "$raw" | sed -e '/^[[:space:]]*$/d' | head -n 1)
    [ -n "$first_line" ] || return 1

    stripped=$(printf '%s\n' "$raw" \
        | sed -E -e '1s/^[[:space:]]*(CMD:|CMD：|【CMD】|\[CMD\])[[:space:]]*//' \
                 -e '1s/^[[:space:]]*(TEXT:|TEXT：|【TEXT】|\[TEXT\])[[:space:]]*//')

    case "$first_line" in
        CMD:*|CMD：*|【CMD】*|'[CMD]'*)
            REPLY_TYPE=cmd
            REPLY_BODY="$stripped"
            return 0
            ;;
        TEXT:*|TEXT：*|【TEXT】*|'[TEXT]'*)
            REPLY_TYPE=text
            REPLY_BODY="$stripped"
            return 0
            ;;
    esac

    # No marker: judge by shape. Anything that reads like prose stays prose,
    # because a mistake in that direction only prints text instead of running it.
    local lines
    lines=$(printf '%s\n' "$raw" | grep -cve '^[[:space:]]*$')
    if [ "$lines" -gt 1 ]; then
        REPLY_TYPE=text
        REPLY_BODY="$raw"
    elif looks_like_command "$raw"; then
        REPLY_TYPE=cmd
        REPLY_BODY="$raw"
    else
        REPLY_TYPE=text
        REPLY_BODY="$raw"
    fi
    return 0
}

is_dangerous() {
    printf '%s\n' "$1" | grep -qiE "$DANGER_PATTERN"
}

# Strip fences, comments, prompt echoes and blank lines from a command block.
clean_cmd() {
    printf '%s\n' "$1" \
        | sed -E -e 's/^[[:space:]]*```[a-zA-Z0-9_+-]*[[:space:]]*$//' -e 's/^[[:space:]]*```[[:space:]]*$//' \
        | grep -v '^[[:space:]]*#' \
        | grep -v '^[[:space:]]*$' \
        | sed -e 's/^[[:space:]]*\$[[:space:]]*//' \
        | head -n 5
}

# Turn a multi-line command block into a single line joined by &&.
join_cmd() {
    printf '%s\n' "$1" | awk 'NF { if (n++) printf " && "; printf "%s", $0 } END { printf "\n" }'
}

show_cmd() {
    printf '\n\033[36mgenerated>\033[0m\n'
    printf '\033[33m%s\033[0m\n' "$1"
}

show_text() {
    printf '\n\033[32manswer>\033[0m\n'
    printf '%s\n' "$1"
}

run_cmd() {
    printf '\n\033[90m--- output ---\033[0m\n'
    OUTPUT=$(bash -c "$1" 2>&1)
    local rc=$?
    printf '%s\n' "$OUTPUT"
    printf '\033[90m--- exit code: %d ---\033[0m\n' "$rc"
    return $rc
}

printf '\033[36mTermux AI Harness\033[0m\n'
printf 'endpoint: %s\n' "$API_URL"
printf 'mode: human in the loop (chat is answered, commands are shown and need y)\n'
printf 'commands: /exit  quit   /help  help\n'

while :; do
    printf '\n\033[36mTask>\033[0m '
    IFS= read -r req || break

    case "$req" in
        ''|' '*|$'\t'*) continue ;;
        /exit|/quit|exit|quit) break ;;
        /help)
            printf 'Describe what you want done in plain language, or just ask a question.\n'
            printf 'Questions are answered directly. Commands are shown first; press y to run.\n'
            continue
            ;;
    esac

    attempt=0
    context="$req"

    while :; do
        reply=$(request_reply "$context") || break

        if ! parse_reply "$reply"; then
            printf 'agent returned an empty reply\n'
            break
        fi

        if [ "$REPLY_TYPE" = text ]; then
            show_text "$REPLY_BODY"
            break
        fi

        cmd=$(clean_cmd "$REPLY_BODY")
        [ -n "$cmd" ] || { printf 'agent returned no command\n'; break; }

        cmd=$(join_cmd "$cmd")

        if is_dangerous "$cmd"; then
            printf '\n\033[31m[blocked] dangerous pattern detected, command refused:\033[0m\n'
            printf '\033[33m%s\033[0m\n' "$cmd"
            break
        fi

        show_cmd "$cmd"

        if [ "$AUTO_RETRY" = "1" ]; then
            answer="y"
        else
            printf 'run it? [y/N] '
            IFS= read -r answer || break
        fi

        case "$answer" in
            y|Y|yes|YES) ;;
            *) printf 'skipped\n'; break ;;
        esac

        if run_cmd "$cmd"; then
            break
        fi

        attempt=$((attempt + 1))
        if [ "$attempt" -gt "$MAX_RETRY" ]; then
            printf 'gave up after %d attempts\n' "$MAX_RETRY"
            break
        fi
        printf '\n\033[33mretrying with error context (%d/%d)\033[0m\n' "$attempt" "$MAX_RETRY"
        context="$req
The previous command failed:
$cmd
Its output was:
$OUTPUT
Reply with a corrected command starting with CMD:."
        continue
    done
done

printf '\nbye.\n'
